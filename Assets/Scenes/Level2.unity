    - target: {fileID: 4226645283735207914, guid: c28f7178a3f01d443b5ed4c9e8427dd1, type: 3}
      propertyPath: phrases.Array.size
      value: 25
      objectReference: {fileID: 0}
    - target: {fileID: 4226645283735207914, guid: c28f7178a3f01d443b5ed4c9e8427dd1, type: 3}
      propertyPath: 'phrases.Array.data[19]'
      value: 'I heard the teachers have a key for all of the classroom doors. '
      objectReference: {fileID: 0}
    - target: {fileID: 4226645283735207914, guid: c28f7178a3f01d443b5ed4c9e8427dd1, type: 3}
      propertyPath: 'phrases.Array.data[20]'
      value: My friend in dance class said they saw the door code.
      objectReference: {fileID: 0}
    - target: {fileID: 4226645283735207914, guid: c28f7178a3f01d443b5ed4c9e8427dd1, type: 3}
      propertyPath: 'phrases.Array.data[21]'
      value: "Those foil weirdos are obsessed with turning off the dance class\u2019
        music. "
      objectReference: {fileID: 0}
    - target: {fileID: 4226645283735207914, guid: c28f7178a3f01d443b5ed4c9e8427dd1, type: 3}
      propertyPath: 'phrases.Array.data[22]'
      value: "Is it true the Principal locked himself in the janitor\u2019s closet?! "
      objectReference: {fileID: 0}
    - target: {fileID: 4226645283735207914, guid: c28f7178a3f01d443b5ed4c9e8427dd1, type: 3}
      propertyPath: 'phrases.Array.data[23]'
      value: "My mom said the Principal\u2019s ex-wife is dating the Mayor!"
      objectReference: {fileID: 0}
    - target: {fileID: 4226645283735207914, guid: c28f7178a3f01d443b5ed4c9e8427dd1, type: 3}
      propertyPath: 'phrases.Array.data[24]'
      value: 'I heard some students are flexible enough to crawl through the vents. '
      objectReference: {fileID: 0}
