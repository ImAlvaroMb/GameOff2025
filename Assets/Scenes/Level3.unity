    - target: {fileID: 3120470353320020652, guid: fedc44d4a4561ba4e94a04e4cf725ca0, type: 3}
      propertyPath: phrases.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 3120470353320020652, guid: fedc44d4a4561ba4e94a04e4cf725ca0, type: 3}
      propertyPath: 'phrases.Array.data[0]'
      value: "Students, I was just like all of you. Except\u2026I WAS at the top
        of my class."
      objectReference: {fileID: 0}
    - target: {fileID: 3120470353320020652, guid: fedc44d4a4561ba4e94a04e4cf725ca0, type: 3}
      propertyPath: 'phrases.Array.data[1]'
      value: Like my father before me, I will prioritize corporate innovation in
        this town.
      objectReference: {fileID: 0}
    - target: {fileID: 3120470353320020652, guid: fedc44d4a4561ba4e94a04e4cf725ca0, type: 3}
      propertyPath: 'phrases.Array.data[2]'
      value: Some say I am privileged, but my parents worked hard for me to stand
        here today.
      objectReference: {fileID: 0}
    - target: {fileID: 3120470353320020652, guid: fedc44d4a4561ba4e94a04e4cf725ca0, type: 3}
      propertyPath: 'phrases.Array.data[3]'
      value: Thanks to my corporate donors, I can make this city great again.
      objectReference: {fileID: 0}
    - target: {fileID: 3120470353320020652, guid: fedc44d4a4561ba4e94a04e4cf725ca0, type: 3}
      propertyPath: 'phrases.Array.data[4]'
      value: ' I pledge to usher in a new era of cooperation and synchronization.'
      objectReference: {fileID: 0}
    - target: {fileID: 3120470353320020652, guid: fedc44d4a4561ba4e94a04e4cf725ca0, type: 3}
      propertyPath: 'phrases.Array.data[5]'
      value: "A Mayor for REALITY - let\u2019s put these silly alien rumors in the
        past."
      objectReference: {fileID: 0}
    - target: {fileID: 3120470353320020652, guid: fedc44d4a4561ba4e94a04e4cf725ca0, type: 3}
      propertyPath: 'phrases.Array.data[6]'
      value: Whether or not your parents voted for me, your future is in my hands!
      objectReference: {fileID: 0}
